# Backend API origin for production builds (no trailing slash).
# Leave empty in local Vite so /api and /storage go through the Vite proxy.
# Example: https://quy-in-sach-api.onrender.com
VITE_API_BASE_URL=

# Supabase Auth (public keys only — never put service_role here).
# When both are set, admin login uses supabase.auth.signInWithPassword.
# When empty, frontend falls back to backend /api/admin/auth/dev-login (local only).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
