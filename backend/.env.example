# PostgreSQL
# Local Docker (day-to-day): both URLs point to the same local DB.
DATABASE_URL="postgresql://quyinsach:quyinsach@localhost:5433/quy_in_sach?schema=public"
DIRECT_URL="postgresql://quyinsach:quyinsach@localhost:5433/quy_in_sach?schema=public"
#
# Supabase (production / cloud) — put real values only in backend/.env (never commit):
# Persistent Node backend: prefer Session pooler for runtime, Session/Direct for migrations.
# DATABASE_URL="postgresql://postgres.PROJECT_REF:[PASSWORD]@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&schema=public"
# DIRECT_URL="postgresql://postgres.PROJECT_REF:[PASSWORD]@aws-0-REGION.pooler.supabase.com:5432/postgres?schema=public"

# App
NODE_ENV=development
PORT=3000
# Bind address (Docker/Render: keep 0.0.0.0)
HOST=0.0.0.0
# Comma-separated allowed origins (Cloudflare Pages URL in production)
CORS_ORIGINS=http://localhost:5173
BODY_LIMIT=1mb
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120

# Local only — MUST be false / unset in production (boot fails if true + NODE_ENV=production)
ALLOW_DEV_LOGIN=true
DEV_ADMIN_PASSWORD=admin123

# Supabase Auth (JWT verification) + Storage (service role ONLY on backend)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Project Settings → API → JWT Secret (used to verify access tokens)
SUPABASE_JWT_SECRET=dev-local-jwt-secret-change-me-in-production

# Storage buckets
SUPABASE_PUBLIC_MEDIA_BUCKET=public-media
SUPABASE_PRIVATE_DOCS_BUCKET=private-documents

# Local Storage fallback ONLY when SUPABASE_URL / SERVICE_ROLE_KEY empty (not allowed in production)
PUBLIC_BASE_URL=http://localhost:3000
LOCAL_STORAGE_DIR=.local-storage
