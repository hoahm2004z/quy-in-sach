generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Session/direct connection for migrate/introspect (required when DATABASE_URL uses PgBouncer).
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────

enum UserRole {
  ADMIN
}

enum ProductType {
  BOOK
  SPEAKER
}

enum ProductStatus {
  UPCOMING
  PRINTED
  ARCHIVED
}

enum DonationStatus {
  PENDING
  CONFIRMED
  VOIDED
}

enum ExpenseStatus {
  PENDING
  CONFIRMED
  VOIDED
}

// ─────────────────────────────────────────────
// USERS (application authorization)
// Auth identity lives in Supabase Auth.
// ─────────────────────────────────────────────

model User {
  id               String   @id @default(uuid()) @db.Uuid
  supabaseUserId   String   @unique @map("supabase_user_id")
  email            String   @unique
  fullName         String   @map("full_name")
  role             UserRole @default(ADMIN)
  isActive         Boolean  @default(true) @map("is_active")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  productsCreated  Product[]   @relation("ProductCreatedBy")
  productsUpdated  Product[]   @relation("ProductUpdatedBy")
  productsDeleted  Product[]   @relation("ProductDeletedBy")
  donationsCreated Donation[]  @relation("DonationCreatedBy")
  donationsDeleted Donation[]  @relation("DonationDeletedBy")
  expensesCreated  Expense[]   @relation("ExpenseCreatedBy")
  expensesDeleted  Expense[]   @relation("ExpenseDeletedBy")
  companionsDeleted Companion[] @relation("CompanionDeletedBy")
  mediaCreated     Media[]     @relation("MediaCreatedBy")
  mediaDeleted     Media[]     @relation("MediaDeletedBy")
  auditLogs        AuditLog[]
  settingsUpdated  Setting[]   @relation("SettingUpdatedBy")

  @@map("users")
}

// ─────────────────────────────────────────────
// MEDIA (metadata only — files in Supabase Storage)
// ─────────────────────────────────────────────

model Media {
  id           String    @id @default(uuid()) @db.Uuid
  bucket       String
  storagePath  String    @map("storage_path")
  fileName     String    @map("file_name")
  mimeType     String    @map("mime_type")
  fileSize     Int       @map("file_size")
  altText      String?   @map("alt_text")
  createdById  String    @map("created_by") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at")
  deletedAt    DateTime? @map("deleted_at")
  deletedById  String?   @map("deleted_by") @db.Uuid
  deleteReason String?   @map("delete_reason")

  createdBy User  @relation("MediaCreatedBy", fields: [createdById], references: [id])
  deletedBy User? @relation("MediaDeletedBy", fields: [deletedById], references: [id])

  coverProducts    Product[]  @relation("ProductCover")
  donationProofs   Donation[] @relation("DonationProof")
  expenseInvoices  Expense[]  @relation("ExpenseInvoice")

  @@index([deletedAt], map: "media_deleted_at_idx")
  @@map("media")
}

// ─────────────────────────────────────────────
// PRODUCTS (books & speakers)
// actual_cost is NOT stored — derived from confirmed expenses.
// ─────────────────────────────────────────────

model Product {
  id               String        @id @default(uuid()) @db.Uuid
  name             String
  description      String?
  productType      ProductType   @map("product_type")
  status           ProductStatus
  budgetEstimate   Decimal       @default(0) @map("budget_estimate") @db.Decimal(18, 2)
  plannedQuantity  Int           @default(0) @map("planned_quantity")
  printedQuantity  Int           @default(0) @map("printed_quantity")
  stockQuantity    Int           @default(0) @map("stock_quantity")
  plannedDate      DateTime?     @map("planned_date") @db.Date
  completedDate    DateTime?     @map("completed_date") @db.Date
  coverMediaId     String?       @map("cover_media_id") @db.Uuid
  isPublic         Boolean       @default(true) @map("is_public")
  createdById      String        @map("created_by") @db.Uuid
  updatedById      String        @map("updated_by") @db.Uuid
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")
  deletedAt        DateTime?     @map("deleted_at")
  deletedById      String?       @map("deleted_by") @db.Uuid
  deleteReason     String?       @map("delete_reason")

  coverMedia Media? @relation("ProductCover", fields: [coverMediaId], references: [id], onDelete: SetNull)
  createdBy  User   @relation("ProductCreatedBy", fields: [createdById], references: [id])
  updatedBy  User   @relation("ProductUpdatedBy", fields: [updatedById], references: [id])
  deletedBy  User?  @relation("ProductDeletedBy", fields: [deletedById], references: [id])

  // Financial FKs: NO cascade delete — history must survive product archive/soft-delete
  donations Donation[]
  expenses  Expense[]

  @@index([productType, status], map: "products_type_status_idx")
  @@index([isPublic, deletedAt], map: "products_public_deleted_idx")
  @@index([createdAt], map: "products_created_at_idx")
  @@map("products")
}

// ─────────────────────────────────────────────
// DONATIONS (income)
// ─────────────────────────────────────────────

model Donation {
  id            String         @id @default(uuid()) @db.Uuid
  donorName     String         @map("donor_name")
  displayName   String?        @map("display_name")
  isAnonymous   Boolean        @default(false) @map("is_anonymous")
  amount        Decimal        @db.Decimal(18, 2)
  donatedAt     DateTime       @map("donated_at") @db.Timestamptz(6)
  content       String?
  productId     String?        @map("product_id") @db.Uuid
  status        DonationStatus @default(PENDING)
  isPublic      Boolean        @default(false) @map("is_public")
  proofMediaId  String?        @map("proof_media_id") @db.Uuid
  note          String?
  createdById   String         @map("created_by") @db.Uuid
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  deletedAt     DateTime?      @map("deleted_at")
  deletedById   String?        @map("deleted_by") @db.Uuid
  deleteReason  String?        @map("delete_reason")

  product    Product? @relation(fields: [productId], references: [id], onDelete: Restrict)
  proofMedia Media?   @relation("DonationProof", fields: [proofMediaId], references: [id], onDelete: SetNull)
  createdBy  User     @relation("DonationCreatedBy", fields: [createdById], references: [id])
  deletedBy  User?    @relation("DonationDeletedBy", fields: [deletedById], references: [id])

  @@index([status, donatedAt], map: "donations_status_donated_at_idx")
  @@index([productId], map: "donations_product_id_idx")
  @@map("donations")
}

// ─────────────────────────────────────────────
// EXPENSES (outflow)
// ─────────────────────────────────────────────

model Expense {
  id              String        @id @default(uuid()) @db.Uuid
  productId       String?       @map("product_id") @db.Uuid
  category        String
  amount          Decimal       @db.Decimal(18, 2)
  expenseDate     DateTime      @map("expense_date") @db.Date
  description     String
  invoiceMediaId  String?       @map("invoice_media_id") @db.Uuid
  status          ExpenseStatus @default(PENDING)
  isPublic        Boolean       @default(false) @map("is_public")
  note            String?
  createdById     String        @map("created_by") @db.Uuid
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")
  deletedAt       DateTime?     @map("deleted_at")
  deletedById     String?       @map("deleted_by") @db.Uuid
  deleteReason    String?       @map("delete_reason")

  product      Product? @relation(fields: [productId], references: [id], onDelete: Restrict)
  invoiceMedia Media?   @relation("ExpenseInvoice", fields: [invoiceMediaId], references: [id], onDelete: SetNull)
  createdBy    User     @relation("ExpenseCreatedBy", fields: [createdById], references: [id])
  deletedBy    User?    @relation("ExpenseDeletedBy", fields: [deletedById], references: [id])

  @@index([status, expenseDate], map: "expenses_status_expense_date_idx")
  @@index([productId], map: "expenses_product_id_idx")
  @@map("expenses")
}

// ─────────────────────────────────────────────
// COMPANIONS (Người đồng hành — independent of donations)
// ─────────────────────────────────────────────

model Companion {
  id           String    @id @default(uuid()) @db.Uuid
  displayName  String    @map("display_name")
  note         String?
  isPublic     Boolean   @default(true) @map("is_public")
  sortOrder    Int       @default(0) @map("sort_order")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")
  deletedById  String?   @map("deleted_by") @db.Uuid
  deleteReason String?   @map("delete_reason")

  deletedBy User? @relation("CompanionDeletedBy", fields: [deletedById], references: [id])

  @@index([isPublic, sortOrder], map: "companions_public_sort_idx")
  @@map("companions")
}

// ─────────────────────────────────────────────
// AUDIT LOGS (immutable via application rules)
// ─────────────────────────────────────────────

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String?  @map("user_id") @db.Uuid
  action    String
  entity    String
  entityId  String   @map("entity_id")
  oldValue  Json?    @map("old_value")
  newValue  Json?    @map("new_value")
  ip        String?
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([entity, entityId], map: "audit_logs_entity_entity_id_idx")
  @@index([createdAt], map: "audit_logs_created_at_idx")
  @@map("audit_logs")
}

// ─────────────────────────────────────────────
// SETTINGS (key-value)
// ─────────────────────────────────────────────

model Setting {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique
  value       Json
  updatedById String?  @map("updated_by") @db.Uuid
  updatedAt   DateTime @updatedAt @map("updated_at")
  createdAt   DateTime @default(now()) @map("created_at")

  updatedBy User? @relation("SettingUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@map("settings")
}
